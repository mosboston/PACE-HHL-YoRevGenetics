<?xml version="1.0"?>
<ProteinAnimations xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ProteinAnimation>
        <name>win</name>
        <resultText>Success!</resultText>
        <MoveProteinToTargetCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>SmoothStep</timeCurve>
            <target>ProteinWinSpot</target>
        </MoveProteinToTargetCommand>
    </ProteinAnimation>
    
    <ProteinAnimation>
        <name>kill</name>
        <resultText>Cell Death</resultText>
        <MoveProteinToTargetCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>EaseInCubic</timeCurve>
            <target>ProteinWinSpot</target>
        </MoveProteinToTargetCommand>
    </ProteinAnimation>
    
    <ProteinAnimation>
        <name>separate</name>
        <OrientToAngleCommand>
            <commandLength>2</commandLength>
            <timeCurve>EaseInCubic</timeCurve>
            <angle>1440</angle>
            <unclamped>true</unclamped>
        </OrientToAngleCommand>
        <ResetCommand/>
    </ProteinAnimation>
    
    <ProteinAnimation>
        <name>bounce</name>
        <resultText>Try Again...</resultText>
        <MoveProteinToTargetButBreakInRangeCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>SmoothStep</timeCurve>
            <target>ProteinWinSpot</target>
            <point>BounceSpot</point>
            <range>230</range>
        </MoveProteinToTargetButBreakInRangeCommand>
        <MoveProteinToRandomTransformCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>EaseOutCubic</timeCurve>
            <target>BounceSpot</target>
            <directionRange>45</directionRange>
            <forwardRange>360</forwardRange>
            <minDistance>100</minDistance>
            <maxDistance>200</maxDistance>
        </MoveProteinToRandomTransformCommand>
    </ProteinAnimation>
    
    <ProteinAnimation>
        <name>fail</name>
        <resultText>Try Again...</resultText>
        <MoveProteinToTargetButBreakInRangeCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>SmoothStep</timeCurve>
            <target>ProteinWinSpot</target>
            <point>BounceSpot</point>
            <range>230</range>
        </MoveProteinToTargetButBreakInRangeCommand>
        <MoveProteinToRandomTransformCommand>
            <commandLength>0.75</commandLength>
            <timeCurve>EaseOutCubic</timeCurve>
            <target>BounceSpot</target>
            <directionRange>45</directionRange>
            <forwardRange>360</forwardRange>
            <minDistance>100</minDistance>
            <maxDistance>200</maxDistance>
        </MoveProteinToRandomTransformCommand>
    </ProteinAnimation>
</ProteinAnimations>