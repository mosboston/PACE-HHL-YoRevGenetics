<?xml version="1.0"?>
<ProteinLogic xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ProteinLogicBlock>
        <blockType>IF</blockType>
        <pieceName>misfold</pieceName>
        <action>separate</action>
        <color>
            <r>1</r>
            <g>1</g>
            <b>0</b>
            <a>1</a>
        </color>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>IF</blockType>
        <pieceName>sword</pieceName>
        <action>kill</action>
        <angle>302</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>IF</blockType>
        <pieceName>bubble</pieceName>
        <action>bounce</action>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>NESTED</blockType>
        <pieceName>key</pieceName>
        <action>IF umbrella THEN fail ELSE win</action>
        <angle>206</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>IF</blockType>
        <pieceName>key_extra</pieceName>
        <action>win</action>
        <angle>0</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>NESTED</blockType>
        <pieceName>square</pieceName>
        <action>IF circle THEN win ELSE fail</action>
        <angle>153</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>IF</blockType>
        <pieceName>circle</pieceName>
        <action>win</action>
        <angle>153</angle>
    </ProteinLogicBlock>
    
    <ProteinLogicBlock>
        <blockType>ELSE</blockType>
        <pieceName>umbrella</pieceName>
        <angle>180</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>ELSE</blockType>
        <pieceName>legs</pieceName>
        <angle>90</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>ELSE</blockType>
        <pieceName>tail</pieceName>
        <angle>45</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>ELSE</blockType>
        <pieceName>wrong_shapes</pieceName>
        <angle>90</angle>
    </ProteinLogicBlock>
    <ProteinLogicBlock>
        <blockType>ELSE</blockType>
        <pieceName>backwards</pieceName>
        <angle>244</angle>
    </ProteinLogicBlock>
    
    <ProteinLogicBlock>
        <blockType>DEFAULT</blockType>
        <action>fail</action>
    </ProteinLogicBlock>
</ProteinLogic>